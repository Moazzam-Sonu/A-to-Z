{"components/halothemes/halo-megamenu-theme-file":"<script defer>\n    var haloMegaMenu = new window.haloMegaMenu();\n    const urlImgLoad = $('.halo-mega-menu').data('image-load');\n    const urlStoreHash = $('.halo-mega-menu').data('store-hash-image');\n\n    function setItemMegaMenu(){\n        if($(window).width() > 1024) {\n            $('.navPages-list-megamenu > li').on('mouseover', function () {\n\n                var numberItem = $(this).index() + 1;\n\n                if (!$(this).hasClass('has-megamenu')) {\n                    LoadMegaMenu(numberItem);\n                }\n            });\n\n            $('.navPages-list-megamenu > li').on('focusin', function () {\n\n                var numberItem = $(this).index() + 1;\n\n                if (!$(this).hasClass('has-megamenu')) {\n                    LoadMegaMenu(numberItem);\n                }\n            });\n        }\n\n        $(document).on('click','#halo-menu-mobile .navPages-list:not(.navPages-list--user) > li > .navPages-action' , function() {\n            var numberItem = $(this).parent().index() + 1;\n\n            if (!$(this).parent().hasClass('has-megamenu')) {\n                loadMegaMenu(numberItem);\n            }\n        });\n    }\n        \n    function loadMegaMenu(numberItem){\n        if (numberItem == 1) {\n            haloMegaMenu.menuItem(numberItem).setMegaMenu({\n                style: 'style 1',\n                imageAreaWidth: '50%',\n                cateAreaWidth: '50%',\n                productId: '122,124,118,125,130,132',\n                cateColumns: 3,\n                products:'<h3 class=\"megamenu-title\">Featured Products</h3>\\\n                        <div class=\"megamenu-slider\"></div>',\n                content: '<ul class=\"navPage-subMenu-links navPage-subMenu-list\">\\\n                            <li class=\"navPage-subMenu-item-child\">\\\n                                <p class=\"navPage-subMenu-action navPages-action navPages-action-depth-max has-subMenu\">\\\n                                    <span class=\"text\">Shop by</span>\\\n                                    <span class=\"navPages-action-moreIcon\" aria-hidden=\"true\">\\\n                                        <svg class=\"icon\" aria-hidden=\"true\"><use xlink:href=\"#icon-chevron-down\"></use></svg>\\\n                                    </span>\\\n                                </p>\\\n                                <div class=\"navPage-subMenu navPage-subMenu-horizontal\" aria-hidden=\"true\" tabindex=\"-1\">\\\n                                    <ul class=\"navPage-subMenu-list\">\\\n                                        <li class=\"navPage-subMenu-item-child navPage-subMenu-title\">\\\n                                            <p class=\"navPage-subMenu-action navPages-action\">\\\n                                                <span class=\"navPages-action-moreIcon\" aria-hidden=\"true\">\\\n                                                    <svg class=\"icon\" aria-hidden=\"true\"><use xlink:href=\"#icon-chevron-down\"></use></svg>\\\n                                                    <span>back</span>\\\n                                                </span>\\\n                                                <span class=\"text\">Shop by</span>\\\n                                            </p>\\\n                                        </li>\\\n                                        <li class=\"navPage-subMenu-item-child navPages-action-end\">\\\n                                            <a class=\"navPage-subMenu-action navPages-action\" href=\"/new-arrivals/?sort=newest\"><span class=\"text\">What New</span></a>\\\n                                        </li>\\\n                                        <li class=\"navPage-subMenu-item-child navPages-action-end\">\\\n                                            <a class=\"navPage-subMenu-action navPages-action\" href=\"/new-arrivals/?sort=bestselling\"><span class=\"text\">Best Selling</span></a>\\\n                                        </li>\\\n                                        <li class=\"navPage-subMenu-item-child navPages-action-end\">\\\n                                            <a class=\"navPage-subMenu-action navPages-action\" href=\"/new-arrivals/?sort=avgcustomerreview\"><span class=\"text\">Top Rated</span></a>\\\n                                        </li>\\\n                                        <li class=\"navPage-subMenu-item-child navPages-action-end\">\\\n                                            <a class=\"navPage-subMenu-action navPages-action\" href=\"/new-arrivals/?sort=featured\"><span class=\"text\">Most Popular</span></a>\\\n                                        </li>\\\n                                        <li class=\"navPage-subMenu-item-child navPages-action-end\">\\\n                                            <a class=\"navPage-subMenu-action navPages-action\" href=\"/new-arrivals/?sort=priceasc\"><span class=\"text\">Editor Pick</span></a>\\\n                                        </li>\\\n                                    </ul>\\\n                                </div>\\\n                            </li>\\\n                        </ul>',\n                images: '<a class=\"image\" href=\"#\">\\\n                            <img class=\"lazyload\" src=\"'+urlImgLoad+'\" data-src=\"'+urlStoreHash+'halo-megamenu-1.jpg\" alt=\"Cosmopolis\" title=\"Cosmopolis\"/>\\\n                        </a>'\n            });\n        } else if (numberItem == 2){\n            haloMegaMenu.menuItem(numberItem).setMegaMenu({\n                style: 'style 2',\n                imageAreaWidth: '50%',\n                cateAreaWidth: '50%',\n                cateColumns: 3,\n                content: '<ul class=\"navPage-subMenu-links navPage-subMenu-list\">\\\n                            <li class=\"navPage-subMenu-item-child\">\\\n                                <p class=\"navPage-subMenu-action navPages-action navPages-action-depth-max has-subMenu\">\\\n                                    <span class=\"text\">Shop By</span>\\\n                                    <span class=\"navPages-action-moreIcon\" aria-hidden=\"true\">\\\n                                        <svg class=\"icon\" aria-hidden=\"true\"><use xlink:href=\"#icon-chevron-down\"></use></svg>\\\n                                    </span>\\\n                                </p>\\\n                                <div class=\"navPage-subMenu navPage-subMenu-horizontal\" aria-hidden=\"true\" tabindex=\"-1\">\\\n                                    <ul class=\"navPage-subMenu-list\">\\\n                                        <li class=\"navPage-subMenu-item-child navPage-subMenu-title\">\\\n                                            <p class=\"navPage-subMenu-action navPages-action\">\\\n                                                <span class=\"navPages-action-moreIcon\" aria-hidden=\"true\">\\\n                                                    <svg class=\"icon\" aria-hidden=\"true\"><use xlink:href=\"#icon-chevron-down\"></use></svg>\\\n                                                    <span>back</span>\\\n                                                </span>\\\n                                                <span class=\"text\">Shop By</span>\\\n                                            </p>\\\n                                        </li>\\\n                                        <li class=\"navPage-subMenu-item-child navPages-action-end\">\\\n                                            <a class=\"navPage-subMenu-action navPages-action\" href=\"/succulents/?sort=newest\"><span class=\"text\">What New</span></a>\\\n                                        </li>\\\n                                        <li class=\"navPage-subMenu-item-child navPages-action-end\">\\\n                                            <a class=\"navPage-subMenu-action navPages-action\" href=\"/succulents/?sort=bestselling\"><span class=\"text\">Best Selling</span></a>\\\n                                        </li>\\\n                                        <li class=\"navPage-subMenu-item-child navPages-action-end\">\\\n                                            <a class=\"navPage-subMenu-action navPages-action\" href=\"/succulents/?sort=avgcustomerreview\"><span class=\"text\">Top Rated</span></a>\\\n                                        </li>\\\n                                        <li class=\"navPage-subMenu-item-child navPages-action-end\">\\\n                                            <a class=\"navPage-subMenu-action navPages-action\" href=\"/succulents/?sort=featured\"><span class=\"text\">Most Popular</span></a>\\\n                                        </li>\\\n                                        <li class=\"navPage-subMenu-item-child navPages-action-end\">\\\n                                            <a class=\"navPage-subMenu-action navPages-action\" href=\"/succulents/?sort=priceasc\"><span class=\"text\">Editor Pick</span></a>\\\n                                        </li>\\\n                                    </ul>\\\n                                </div>\\\n                            </li>\\\n                        </ul>',\n                products:'<h3 class=\"megamenu-title\">Types</h3>\\\n                        <div class=\"megamenu-brands\">\\\n                            <a class=\"image\" href=\"#\">\\\n                                <img class=\"lazyload\" src=\"'+urlImgLoad+'\" data-src=\"'+urlStoreHash+'halo-megamenu-brand-1.jpg\" alt=\"Brand Image 1\" title=\"Brand Image 1\">\\\n                            </a>\\\n                            <a class=\"image\" href=\"#\">\\\n                                <img class=\"lazyload\" src=\"'+urlImgLoad+'\" data-src=\"'+urlStoreHash+'halo-megamenu-brand-2.jpg\" alt=\"Brand Image 2\" title=\"Brand Image 2\">\\\n                            </a>\\\n                            <a class=\"image\" href=\"#\">\\\n                                <img class=\"lazyload\" src=\"'+urlImgLoad+'\" data-src=\"'+urlStoreHash+'halo-megamenu-brand-3.jpg\" alt=\"Brand Image 3\" title=\"Brand Image 3\">\\\n                            </a>\\\n                            <a class=\"image\" href=\"#\">\\\n                                <img class=\"lazyload\" src=\"'+urlImgLoad+'\" data-src=\"'+urlStoreHash+'halo-megamenu-brand-4.jpg\" alt=\"Brand Image 4\" title=\"Brand Image 4\">\\\n                            </a>\\\n                        </div>',\n                images: '<div class=\"item\"><a class=\"image\" href=\"#\">\\\n                            <img class=\"lazyload\" src=\"'+urlImgLoad+'\" data-src=\"'+urlStoreHash+'halo-megamenu-2.jpg\" alt=\"Megamenu Image\" title=\"Megamenu Image\"/>\\\n                        </a></div>\\\n                        <div class=\"item\"><a class=\"image\" href=\"#\">\\\n                            <img class=\"lazyload\" src=\"'+urlImgLoad+'\" data-src=\"'+urlStoreHash+'halo-megamenu-3.jpg\" alt=\"Megamenu Image\" title=\"Megamenu Image\"/>\\\n                        </a></div>'\n            });\n        } else if (numberItem == 3){\n            haloMegaMenu.menuItem(numberItem).setMegaMenu({\n                style: 'style 3',\n                cateColumns: 5,\n                imagesTop: ['<a class=\"image\" href=\"#\"><img class=\"lazyload\" src=\"'+urlImgLoad+'\"  data-src=\"'+urlStoreHash+'halo-megamenu-4.jpg\" alt=\"Succulents\" title=\"Succulents\"/></a>',\n                            '<a class=\"image\" href=\"#\"><img class=\"lazyload\" src=\"'+urlImgLoad+'\"  data-src=\"'+urlStoreHash+'halo-megamenu-5.jpg\" alt=\"Indoor Succulents\" title=\"Indoor Succulents\"/></a>',\n                            '<a class=\"image\" href=\"#\"><img class=\"lazyload\" src=\"'+urlImgLoad+'\"  data-src=\"'+urlStoreHash+'halo-megamenu-6.jpg\" alt=\"Outdoor Succulents\" title=\"Outdoor Succulents\"/></a>',\n                            '<a class=\"image\" href=\"#\"><img class=\"lazyload\" src=\"'+urlImgLoad+'\"  data-src=\"'+urlStoreHash+'halo-megamenu-7.jpg\" alt=\"Rare Succulents\" title=\"Rare Succulents\"/></a>',\n                            '<a class=\"image\" href=\"#\"><img class=\"lazyload\" src=\"'+urlImgLoad+'\"  data-src=\"'+urlStoreHash+'halo-megamenu-8.jpg\" alt=\"Most Popular\" title=\"Most Popular\"/></a>'\n                ],\n                bottomCates: '<div class=\"megamenu-custom-list\"><div class=\"container\"><span class=\"text\">Sale upto 40% off on selected items.</span></div></div>',\n                countDown: 'Dec 31, 2024 18:00:00'\n            });\n        } else if (numberItem == 4){ \n            haloMegaMenu.menuItem(numberItem).setMegaMenu({\n                style: 'style 4',\n                cateColumns: 3,\n                productId: '122,124,126',\n                products:'<h3 class=\"megamenu-title\">Top Rated</h3>\\\n                        <div class=\"megamenu-slider2\"></div>',\n                images: '<div class=\"item\"><a class=\"image\" href=\"#\">\\\n                            <img class=\"lazyload\" src=\"'+urlImgLoad+'\" data-src=\"'+urlStoreHash+'halo-megamenu-10.jpg\" alt=\"Best Selling\" title=\"Best Selling\"/>\\\n                        </a></div>\\\n                        <div class=\"item\"><a class=\"image\" href=\"#\">\\\n                            <img class=\"lazyload\" src=\"'+urlImgLoad+'\" data-src=\"'+urlStoreHash+'halo-megamenu-11.jpg\" alt=\"Top Rated\" title=\"Top Rated\"/>\\\n                        </a></div>',\n                imagesCustom: '<a class=\"image\" href=\"#\">\\\n                        <img class=\"lazyload\" src=\"'+urlImgLoad+'\" data-src=\"'+urlStoreHash+'mega-menu-img4.jpg\" alt=\"Tools and Accessories\" title=\"Tools and Accessories\"/>\\\n                        </a>'\n            });\n        } else{\n            return;\n        }\n    }\n\n    function megaMenuLabel(){\n        haloMegaMenu.menuItem(1).setMegaMenu({\n            label: 'new',\n            disabled: true,\n        });\n\n        haloMegaMenu.menuItem(2).setMegaMenu({\n            label: 'hot',\n            disabled: true,\n        });\n\n        haloMegaMenu.menuItem(3).setMegaMenu({\n            label: 'sale',\n            disabled: true,\n        });\n    }\n\n    megaMenuLabel();\n\n    var setItemMegaMenu = setItemMegaMenu();\n\n    window.onload = setItemMegaMenu;\n</script>\n"}
