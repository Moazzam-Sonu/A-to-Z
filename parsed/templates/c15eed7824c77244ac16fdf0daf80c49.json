{"components/halothemes/halo-product-tab-by-category":"<div class=\"halo-block halo-block-product halo-block-product-tabs padding-top-30 padding-bottom-50\">\r\n    <div class=\"container\">\r\n        {{#unless theme_settings.halo_homepage_layout_3}}\r\n            <div class=\"halo-block-header\">\r\n                <h3 class=\"title\">{{title}}</h3>\r\n            </div>\r\n        {{/unless}}\r\n        <div class=\"productCarousel-tabs\">\r\n            {{#if theme_settings.halo_homepage_layout_3}}\r\n                <div class=\"halo-block-header\">\r\n                    <h3 class=\"title\">{{title}}</h3>\r\n                    <ul class=\"tabs\" data-tab role=\"tablist\">\r\n                        {{#each (limit categories theme_settings.home_product_block-id-tab-cate-limit)}}\r\n                            {{#if @index '==' 0}}\r\n                                <li class=\"tab is-active\" role=\"presentation\">\r\n                                    <a class=\"tab-title\" href=\"#category_{{id}}\" role=\"tab\" tabindex=\"0\" aria-selected=\"true\" aria-controls=\"category_{{id}}\">\r\n                                        <span>{{name}}</span>\r\n                                    </a>\r\n                                </li>\r\n                            {{else}}\r\n                                <li class=\"tab\" role=\"presentation\">\r\n                                    <a class=\"tab-title\" href=\"#category_{{id}}\" role=\"tab\" tabindex=\"0\" aria-selected=\"false\" aria-controls=\"category_{{id}}\">\r\n                                        <span>{{name}}</span>\r\n                                    </a>\r\n                                </li>\r\n                            {{/if}}\r\n                        {{/each}}\r\n                    </ul>\r\n                </div>\r\n            {{else}}\r\n                <ul class=\"tabs\" data-tab role=\"tablist\">\r\n                    {{#each (limit categories theme_settings.home_product_block-id-tab-cate-limit)}}\r\n                        {{#if @index '==' 0}}\r\n                            <li class=\"tab is-active\" role=\"presentation\">\r\n                                <a class=\"tab-title\" href=\"#category_{{id}}\" role=\"tab\" tabindex=\"0\" aria-selected=\"true\" aria-controls=\"category_{{id}}\">\r\n                                    <span>{{name}}</span>\r\n                                </a>\r\n                            </li>\r\n                        {{else}}\r\n                            <li class=\"tab\" role=\"presentation\">\r\n                                <a class=\"tab-title\" href=\"#category_{{id}}\" role=\"tab\" tabindex=\"0\" aria-selected=\"false\" aria-controls=\"category_{{id}}\">\r\n                                    <span>{{name}}</span>\r\n                                </a>\r\n                            </li>\r\n                        {{/if}}\r\n                    {{/each}}\r\n                </ul>\r\n            {{/if}}\r\n            <div class=\"tabs-contents\">\r\n                {{#each (limit categories theme_settings.home_product_block-id-tab-cate-limit)}}\r\n                    {{#if @index '==' 0}}\r\n                        <div class=\"tab-content is-active\" id=\"category_{{id}}\" role=\"tabpanel\" aria-hidden=\"true\" data-tab-category-id=\"{{id}}\" data-tab-category-url=\"{{concat url ../../data-sort-tab}}\">\r\n                            <div class=\"loadingOverlay\"></div>\r\n                            <div class=\"productCarousel\"></div>\r\n                        </div>\r\n                    {{else}}\r\n                        <div class=\"tab-content\" id=\"category_{{id}}\" role=\"tabpanel\" aria-hidden=\"false\" data-tab-category-id=\"{{id}}\" data-tab-category-url=\"{{concat url ../../data-sort-tab}}\">\r\n                            <div class=\"loadingOverlay\"></div>\r\n                            <div class=\"productCarousel\"></div>\r\n                        </div>\r\n                    {{/if}}\r\n                {{/each}}\r\n            </div>\r\n        </div>\r\n    </div>\r\n</div>\r\n{{{region name=\"home_below_products_tab_by_category\"}}}\r\n"}
