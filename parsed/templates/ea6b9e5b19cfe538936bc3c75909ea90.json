{"components/halothemes/halo-ask-an-expert":"{{#if page_type '!==' 'page_contact_form'}}\n    {{#all (if theme_settings.halo_ask_an_expert) (if theme_settings.halo_ask_an_expert_pagelink)}}\n        <div class=\"halo-ask-an-expert-btn{{#if theme_settings.halo_ask_an_expert_btn}} hasImage{{else}} noImage{{/if}}\">\n            <a class=\"ask-an-expert-link\" href=\"#\" aria-label=\"{{theme_settings.halo_ask_an_expert_title}}\">\n                {{#if theme_settings.halo_ask_an_expert_btn}}\n                <img class=\"lazyload\" src=\"{{cdn 'img/loading.svg'}}\" data-src=\"https://cdn11.bigcommerce.com/s-{{settings.store_hash}}/product_images/uploaded_images/{{theme_settings.halo_ask_an_expert_btn}}\" alt=\"{{theme_settings.halo_ask_an_expert_title}}\" title=\"{{theme_settings.halo_ask_an_expert_title}}\">\n                {{else}}\n                    <span class=\"icon\">\n                        <svg aria-hidden=\"true\"><use xlink:href=\"#icon-question\"></use></svg>\n                    </span>\n                {{/if}}\n            </a>\n        </div>\n        <div id=\"halo-ask-an-expert-popup\" class=\"halo-popup halo-ask-an-expert-popup\">\n            <div class=\"halo-ask-an-expert-container\">\n                <button type=\"button\" data-close-ask-an-expert-popup>\n                    <svg class=\"icon\" role=\"img\" aria-label=\"{{lang 'common.close'}}\">\n                        <title>{{lang 'common.close'}}</title>\n                        <desc>{{lang 'common.close'}}</desc>\n                        <use href=\"#icon-close\"></use>\n                    </svg>\n                </button>\n                <div class=\"modal-header\">\n                    <h2 class=\"modal-header-title\">{{theme_settings.halo_ask_an_expert_title}}</h2>\n                </div>\n                {{#if theme_settings.halo_ask_an_expert_logo}}\n                    <div class=\"halo-ask-an-expert-logo\">\n                        <a href=\"/\">\n                            <img class=\"lazyload\" src=\"{{cdn 'img/loading.svg'}}\" data-src=\"https://cdn11.bigcommerce.com/s-{{settings.store_hash}}/product_images/uploaded_images/{{theme_settings.halo_ask_an_expert_logo}}\" alt=\"{{settings.store_logo.title}}\" title=\"{{settings.store_logo.title}}\">\n                        </a>\n                    </div>\n                {{/if}}\n                <div class=\"modal-body\" {{#if page_type '==' 'product'}}data-product-id=\"{{product.id}}\" data-product-title=\"{{product.title}}\" data-product-url=\"{{product.url}}\" data-product-sku=\"{{product.sku}}\" data-product-image=\"{{getImage product.main_image}}\"{{/if}}>\n                    <div class=\"halo-ask-an-expert-subtitle\">\n                        <span>{{theme_settings.halo_ask_an_expert_subtitle}}</span>\n                    </div>\n                    <div class=\"halo-ask-an-expert-text\">{{theme_settings.halo_ask_an_expert_text1}}<br>{{theme_settings.halo_ask_an_expert_text2}}</div>\n                    <div id=\"halo-ask-an-expert-results\" class=\"halo-ask-an-expert-text\"></div>\n\n                    <form data-contact-form class=\"halo-ask-an-expert-form\" action=\"{{urls.contact_us_submit}}\" method=\"post\" data-product-id=\"{{product.id}}\" data-product-title=\"{{product.title}}\" data-product-url=\"{{product.url}}\" data-product-sku=\"{{product.sku}}\">\n                        <fieldset class=\"form-fieldset\">\n                            <div class=\"hl-form-field-wrapper\"></div>\n                            <div class=\"form-field form-field-radio\">\n                                <label class=\"form-label\">Do you need:</label>\n                                <input class=\"form-radio\" id=\"pricing-radio\" type=\"radio\" name=\"type_package\" checked value=\"Pricing\">\n                                <label class=\"form-label\" for=\"pricing-radio\">Pricing</label>\n                                <input class=\"form-radio\" id=\"answers-radio\" type=\"radio\" name=\"type_package\" value=\"Answers\">\n                                <label class=\"form-label\" for=\"answers-radio\">Answers</label>\n                                <input class=\"form-radio\" id=\"both-radio\" type=\"radio\" name=\"type_package\" value=\"Pricing & Answers\">\n                                <label class=\"form-label\" for=\"both-radio\">Both</label>\n                            </div>\n                            <div class=\"form-field\">\n                                <label class=\"form-label\" for=\"contact_comment_area\">What can i help you with today?\n                                    <small>{{lang 'common.required' }}</small>\n                                </label>\n                                <textarea name=\"contact_comment_area\" cols=\"30\" rows=\"6\" class=\"form-input\" id=\"contact_comment_area\" required></textarea>\n                            </div>\n                            <div class=\"form-field form-field-radio form-field-radio2\">\n                                <label class=\"form-label form-label-custom\">How would you like me to contact you?</label>\n                                <input class=\"form-radio\" id=\"phone-radio\" type=\"radio\" name=\"type_contact\" checked value=\"Phone\">\n                                <label class=\"form-label\" for=\"phone-radio\">Phone</label>\n                                <input class=\"form-radio\" id=\"email-radio\" type=\"radio\" name=\"type_contact\" value=\"Email\">\n                                <label class=\"form-label\" for=\"email-radio\">Email</label>\n                                <input class=\"form-radio\" id=\"both-radio-2\" type=\"radio\" name=\"type_contact\" value=\"Phone & Email\">\n                                <label class=\"form-label\" for=\"both-radio-2\">Both</label>\n                            </div>\n                            <div class=\"hl-form-field\" style=\"display: none;\">\n                                <textarea name=\"contact_question\" cols=\"30\" rows=\"6\" class=\"form-input\" id=\"contact_question\"></textarea>\n                            </div>\n                            <div class=\"form-field form-field-checkbox\">\n                                <input type=\"checkbox\" id=\"term-ask\" name=\"new\" value=\"Terms Conditions\">\n                                <label class=\"form-label\" for=\"term-ask\">\n                                    I agree with the <span>Data Protection Policy</span> for the Annie's Garden Ask an Expert Form\n                                </label>\n                            </div>\n                            <div class=\"g-recaptcha\" data-sitekey=\"6LcjX0sbAAAAACp92-MNpx66FT4pbIWh-FTDmkkz\"></div>\n                            <div class=\"form-actions\">\n                                <button type=\"submit\" class=\"button button--primary\" id=\"halo-ask-an-expert-button\" disabled>Submit</button>\n                            </div>\n                        </fieldset>\n                    </form>\n                    <script src=\"https://www.google.com/recaptcha/api.js\" async=\"\" defer=\"\"></script>\n                </div>\n            </div>\n        </div>\n    {{/all}}\n{{/if}}\n"}
